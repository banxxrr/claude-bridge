{
  "schemaVersion": 1,
  "id": "banxxrr.claude-bridge",
  "name": "Claude Bridge",
  "version": "0.3.1",
  "author": "banxxr",
  "license": "MIT",
  "description": "Keeps Claude Desktop's dispatch bridge up so this machine is always reachable from claude.ai or your phone, and shows at a glance whether it is. Starts Claude Desktop with your session, restarts it if it dies, and gives you launch/quit/show-hide from the bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Claude Bridge",
    "description": "Keeps Claude Desktop up so you can start sessions here from your phone",
    "category": "AI",
    "aliases": [
      "claude",
      "claude-bridge",
      "dispatch"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5,
      "specialWorkspace": "claude",
      "autostart": true,
      "keepAlive": true
    },
    "schema": [
      {
        "key": "autostart",
        "type": "boolean",
        "label": "Start Claude Desktop with the session",
        "defaultValue": true
      },
      {
        "key": "keepAlive",
        "type": "boolean",
        "label": "Restart it if it stops unexpectedly",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "specialWorkspace",
        "type": "string",
        "label": "Hyprland special workspace name",
        "defaultValue": "claude"
      }
    ]
  }
}